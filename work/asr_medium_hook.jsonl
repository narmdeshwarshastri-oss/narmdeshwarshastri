{"start": 22.4, "end": 37.44, "text": "गरुड़ पुराण 18 पुराणो में से एक और लोग समसते हैं कि यह भस मौत की किताब हैं, घर में कोई चला जाए तो 13 दिन सुन लो और फिर बंद करके रख दो.", "words": [{"s": 22.4, "e": 23.12, "w": " गरुड़"}, {"s": 23.12, "e": 23.52, "w": " पुराण"}, {"s": 23.52, "e": 24.46, "w": " 18"}, {"s": 24.46, "e": 25.14, "w": " पुराणो"}, {"s": 25.14, "e": 25.36, "w": " में"}, {"s": 25.36, "e": 25.5, "w": " से"}, {"s": 25.5, "e": 26.54, "w": " एक"}, {"s": 26.54, "e": 26.86, "w": " और"}, {"s": 26.86, "e": 27.1, "w": " लोग"}, {"s": 27.1, "e": 27.62, "w": " समसते"}, {"s": 27.62, "e": 28.24, "w": " हैं"}, {"s": 28.24, "e": 28.36, "w": " कि"}, {"s": 28.36, "e": 28.52, "w": " यह"}, {"s": 28.52, "e": 28.76, "w": " भस"}, {"s": 28.76, "e": 29.36, "w": " मौत"}, {"s": 29.36, "e": 29.44, "w": " की"}, {"s": 29.44, "e": 29.76, "w": " किताब"}, {"s": 29.76, "e": 30.92, "w": " हैं,"}, {"s": 30.92, "e": 31.16, "w": " घर"}, {"s": 31.16, "e": 31.3, "w": " में"}, {"s": 31.3, "e": 31.5, "w": " कोई"}, {"s": 31.5, "e": 31.88, "w": " चला"}, {"s": 31.88, "e": 32.64, "w": " जाए"}, {"s": 32.64, "e": 32.98, "w": " तो"}, {"s": 32.98, "e": 33.3, "w": " 13"}, {"s": 33.3, "e": 34.0, "w": " दिन"}, {"s": 34.0, "e": 34.42, "w": " सुन"}, {"s": 34.42, "e": 35.02, "w": " लो"}, {"s": 35.02, "e": 35.42, "w": " और"}, {"s": 35.42, "e": 35.62, "w": " फिर"}, {"s": 35.62, "e": 35.9, "w": " बंद"}, {"s": 35.9, "e": 36.52, "w": " करके"}, {"s": 36.52, "e": 36.88, "w": " रख"}, {"s": 36.88, "e": 37.44, "w": " दो."}]}
{"start": 37.44, "end": 52.02, "text": "पर सचिया है कि इस पूरी किताब का बहुत छोटा सा हिस्सा मृत्यु पर है, बाकी में रत्नो की पहचान है, आयूरवेद है, ग्रहनक्षत्र और मूर्त का पूरा जोतिश है.", "words": [{"s": 37.44, "e": 37.88, "w": " पर"}, {"s": 37.88, "e": 38.5, "w": " सचिया"}, {"s": 38.5, "e": 38.96, "w": " है"}, {"s": 38.96, "e": 39.26, "w": " कि"}, {"s": 39.26, "e": 39.44, "w": " इस"}, {"s": 39.44, "e": 39.72, "w": " पूरी"}, {"s": 39.72, "e": 40.16, "w": " किताब"}, {"s": 40.16, "e": 40.88, "w": " का"}, {"s": 40.88, "e": 41.38, "w": " बहुत"}, {"s": 41.38, "e": 41.88, "w": " छोटा"}, {"s": 41.88, "e": 42.0, "w": " सा"}, {"s": 42.0, "e": 42.64, "w": " हिस्सा"}, {"s": 42.64, "e": 43.3, "w": " मृत्यु"}, {"s": 43.3, "e": 43.34, "w": " पर"}, {"s": 43.34, "e": 43.96, "w": " है,"}, {"s": 44.14, "e": 44.56, "w": " बाकी"}, {"s": 44.56, "e": 45.04, "w": " में"}, {"s": 45.04, "e": 45.72, "w": " रत्नो"}, {"s": 45.72, "e": 45.82, "w": " की"}, {"s": 45.82, "e": 46.3, "w": " पहचान"}, {"s": 46.3, "e": 46.84, "w": " है,"}, {"s": 47.02, "e": 47.66, "w": " आयूरवेद"}, {"s": 47.66, "e": 48.06, "w": " है,"}, {"s": 48.26, "e": 49.34, "w": " ग्रहनक्षत्र"}, {"s": 49.34, "e": 49.62, "w": " और"}, {"s": 49.62, "e": 50.06, "w": " मूर्त"}, {"s": 50.06, "e": 50.64, "w": " का"}, {"s": 50.64, "e": 51.0, "w": " पूरा"}, {"s": 51.0, "e": 51.44, "w": " जोतिश"}, {"s": 51.44, "e": 52.02, "w": " है."}]}
{"start": 52.02, "end": 65.48, "text": "और जो हिस्सा मृत्यु पर है, वह भी डराने के लिए नहीं लिखा गया, वह इसलिये लिखा गया, ताकि हमें पता रहे, कि जो जा रहा है, उसका सांथ आखर तक कैसे दिया जाए.", "words": [{"s": 52.02, "e": 52.36, "w": " और"}, {"s": 52.36, "e": 52.5, "w": " जो"}, {"s": 52.5, "e": 53.28, "w": " हिस्सा"}, {"s": 53.28, "e": 53.9, "w": " मृत्यु"}, {"s": 53.9, "e": 54.0, "w": " पर"}, {"s": 54.0, "e": 54.4, "w": " है,"}, {"s": 54.64, "e": 54.8, "w": " वह"}, {"s": 54.8, "e": 54.98, "w": " भी"}, {"s": 54.98, "e": 55.48, "w": " डराने"}, {"s": 55.48, "e": 55.54, "w": " के"}, {"s": 55.54, "e": 55.62, "w": " लिए"}, {"s": 55.62, "e": 55.76, "w": " नहीं"}, {"s": 55.76, "e": 56.06, "w": " लिखा"}, {"s": 56.06, "e": 56.6, "w": " गया,"}, {"s": 56.84, "e": 57.16, "w": " वह"}, {"s": 57.16, "e": 57.66, "w": " इसलिये"}, {"s": 57.66, "e": 57.98, "w": " लिखा"}, {"s": 57.98, "e": 58.54, "w": " गया,"}, {"s": 58.66, "e": 58.88, "w": " ताकि"}, {"s": 58.88, "e": 59.52, "w": " हमें"}, {"s": 59.52, "e": 59.86, "w": " पता"}, {"s": 59.86, "e": 60.32, "w": " रहे,"}, {"s": 60.56, "e": 60.66, "w": " कि"}, {"s": 60.66, "e": 61.1, "w": " जो"}, {"s": 61.1, "e": 61.44, "w": " जा"}, {"s": 61.44, "e": 61.74, "w": " रहा"}, {"s": 61.74, "e": 62.2, "w": " है,"}, {"s": 62.38, "e": 62.68, "w": " उसका"}, {"s": 62.68, "e": 63.3, "w": " सांथ"}, {"s": 63.3, "e": 63.84, "w": " आखर"}, {"s": 63.84, "e": 64.48, "w": " तक"}, {"s": 64.48, "e": 64.9, "w": " कैसे"}, {"s": 64.9, "e": 65.16, "w": " दिया"}, {"s": 65.16, "e": 65.48, "w": " जाए."}]}
