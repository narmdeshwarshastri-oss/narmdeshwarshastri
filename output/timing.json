 "sentences": [
  {
   "id": "S1",
   "text": "गरुड़ पुराण, जिस किताब को लोग अपने घर में रखने से भी डरते हैं। आपने कभी सोचा है कि उसके भीतर आखिर लिखा क्या है?",
   "given_time_published": "0:07",
   "src_start": 9.757,
   "src_end": 21.026,
   "edit_start": 0.117,
   "edit_end": 11.186,
   "asr_words": "गरुड़ पुराण जिस किताब को लोग अपने घर में रखने से भी डरते हैं, आपने कभी सोचा हैं कि उसके भीतर आखिर लिखा क्या हैं?"
  },
  {
   "id": "S2",
   "text": "गरुड़ पुराण 18 पुराणों में से एक, और लोग समझते हैं कि यह बस मौत की किताब है।",
   "given_time_published": "0:20",
   "src_start": 22.676,
   "src_end": 29.738,
   "edit_start": 12.156,
   "edit_end": 18.738,
   "asr_words": "गरुड़ पुराण 18 पुराणो में से एक और लोग समसते हैं कि यह भस मौत की किताब हैं,"
  },
  {
   "id": "S3",
   "text": "घर में कोई चला जाए तो 13 दिन सुन लो और फिर बन्द करके रख दो। पर सच यह है कि इस पूरी किताब का बहुत छोटा सा हिस्सा मृत्यु पर है।",
   "given_time_published": "0:28",
   "src_start": 30.828,
   "src_end": 43.454,
   "edit_start": 19.628,
   "edit_end": 32.254,
   "asr_words": "घर में कोई चला जाए तो 13 दिन सुन लो और फिर बंद करके रख दो. पर सचिया है कि इस पूरी किताब का बहुत छोटा सा हिस्सा मृत्यु पर है,"
  },
  {
   "id": "S4",
   "text": "बाकी में रत्नों की पहचान है। आयुर्वेद है। ग्रह, नक्षत्र और मुहूर्त का पूरा ज्योतिष है।",
   "given_time_published": "0:37",
   "src_start": 44.056,
   "src_end": 51.506,
   "edit_start": 32.856,
   "edit_end": 40.306,
   "asr_words": "बाकी में रत्नो की पहचान है, आयूरवेद है, ग्रहनक्षत्र और मूर्त का पूरा जोतिश है."
  },
  {
   "id": "S5",
   "text": "और जो हिस्सा मृत्यु पर है, वह भी डराने के लिए नहीं लिखा गया। वह इसलिए लिखा गया ताकि हमें पता रहे कि जो जा रहा है, उसका साथ आखिर तक कैसे दिया जाए।",
   "given_time_published": "0:51",
   "src_start": 52.184,
   "src_end": 65.208,
   "edit_start": 40.984,
   "edit_end": 54.008,
   "asr_words": "और जो हिस्सा मृत्यु पर है, वह भी डराने के लिए नहीं लिखा गया, वह इसलिये लिखा गया, ताकि हमें पता रहे, कि जो जा रहा है, उसका सांथ आखर तक कैसे दिया जाए."
  }
 ],
